@model List<IncidentViewModel>
@{
    ViewData["Title"] = "Incidents";
}

<div class="page-header">
    <div>
        <h1>Incident Dashboard</h1>
        <p>MVC frontend → Web API → SQL Server</p>
    </div>
    <a class="button" asp-action="Create">Create Incident</a>
</div>

@if (ViewBag.ApiError != null)
{
    <div class="alert">@ViewBag.ApiError</div>
}

@if (Model.Count == 0)
{
    <div class="card">No incidents yet.</div>
}
else
{
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created UTC</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var incident in Model)
            {
                <tr>
                    <td>@incident.Id</td>
                    <td>@incident.Title</td>
                    <td>@incident.Priority</td>
                    <td>@incident.Status</td>
                    <td>@incident.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@incident.Id">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@incident.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@model CreateIncidentViewModel
@{
    ViewData["Title"] = "Create Incident";
}

<h1>Create Incident</h1>

<form asp-action="Create" method="post" class="card form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="validation"></span>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="5"></textarea>

    <label asp-for="Priority"></label>
    <select asp-for="Priority">
        <option>Low</option>
        <option selected>Medium</option>
        <option>High</option>
        <option>Critical</option>
    </select>

    <div class="form-actions">
        <button class="button" type="submit">Create</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>

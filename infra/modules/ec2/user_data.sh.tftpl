#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/cloudopstracker-bootstrap.log) 2>&1

echo "Starting CloudOpsTracker bootstrap..."
echo "Image readiness requires a successful per-instance SSM execution."

# cloud-init can run user-data without HOME being defined.
# .NET/NuGet requires HOME or DOTNET_CLI_HOME during restore/publish.
export HOME=/root
export DOTNET_CLI_HOME=/root
export NUGET_PACKAGES=/root/.nuget/packages
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
export DOTNET_NOLOGO=1

mkdir -p "$HOME"
mkdir -p "$DOTNET_CLI_HOME"
mkdir -p "$NUGET_PACKAGES"

dnf update -y
dnf install -y git nginx jq dotnet-sdk-8.0 amazon-cloudwatch-agent logrotate

systemctl enable --now amazon-ssm-agent

# Trust the AWS RDS CA instead of bypassing certificate validation.
curl -fsSL \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
  -o /etc/pki/ca-trust/source/anchors/aws-rds-global-bundle.pem
update-ca-trust

id cloudops >/dev/null 2>&1 || useradd --system --create-home cloudops

mkdir -p /opt/cloudopstracker
mkdir -p /etc/cloudopstracker
mkdir -p /var/log/cloudopstracker

cat >/etc/cloudopstracker/runtime.env <<EOF
AWS_REGION=${aws_region}
DB_HOST=${database_host}
DB_PORT=1433
DB_NAME=CloudOpsTrackerDb
DB_SECRET_ARN=${database_secret_arn}
DATA_PROTECTION_PATH=${data_protection_path}
EOF

chmod 0644 /etc/cloudopstracker/runtime.env

# Fetch precisely the reviewed commit; branch movement cannot change this build.
RELEASE_SHA='${application_git_ref}'
mkdir -p /opt/cloudopstracker/src
git -C /opt/cloudopstracker/src init
git -C /opt/cloudopstracker/src remote add origin '${application_repo_url}'
git -C /opt/cloudopstracker/src fetch --depth 1 origin "$RELEASE_SHA"
git -C /opt/cloudopstracker/src checkout --detach FETCH_HEAD
test "$(git -C /opt/cloudopstracker/src rev-parse HEAD)" = "$RELEASE_SHA"
printf '%s' "$RELEASE_SHA" > /opt/cloudopstracker/release-sha

for PROJECT in API Web; do
  dotnet restore "/opt/cloudopstracker/src/CloudOpsTracker.$PROJECT/CloudOpsTracker.$PROJECT.csproj" --locked-mode
  dotnet publish "/opt/cloudopstracker/src/CloudOpsTracker.$PROJECT/CloudOpsTracker.$PROJECT.csproj" \
    --no-restore -c Release -o "/opt/cloudopstracker/$(echo "$PROJECT" | tr '[:upper:]' '[:lower:]')"
done

chown -R cloudops:cloudops \
  /opt/cloudopstracker/api \
  /opt/cloudopstracker/web \
  /var/log/cloudopstracker

cat >/usr/local/bin/run-cloudopstracker-api <<'EOF'
#!/bin/bash
set -euo pipefail

source /etc/cloudopstracker/runtime.env

SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$DB_SECRET_ARN" \
  --query SecretString \
  --output text)"

DB_USER="$(printf '%s' "$SECRET_JSON" | jq -r '.username')"
DB_PASSWORD="$(printf '%s' "$SECRET_JSON" | jq -r '.password')"

export Database__Host="$DB_HOST"
export Database__Port="$DB_PORT"
export Database__Name="$DB_NAME"
export Database__Username="$DB_USER"
export Database__Password="$DB_PASSWORD"
export UseHttpsRedirection=false
export ASPNETCORE_ENVIRONMENT=Production
export ASPNETCORE_URLS=http://127.0.0.1:5001

exec /usr/bin/dotnet /opt/cloudopstracker/api/CloudOpsTracker.API.dll "$@"
EOF

chmod 0755 /usr/local/bin/run-cloudopstracker-api

cat >/usr/local/bin/run-cloudopstracker-web <<'EOF'
#!/bin/bash
set -euo pipefail

source /etc/cloudopstracker/runtime.env
export DataProtection__ParameterPath="$DATA_PROTECTION_PATH"
export AWS_REGION
export ApiBaseUrl=http://127.0.0.1:5001
export UseHttpsRedirection=false
export ASPNETCORE_ENVIRONMENT=Production
export ASPNETCORE_URLS=http://127.0.0.1:5000

exec /usr/bin/dotnet /opt/cloudopstracker/web/CloudOpsTracker.Web.dll
EOF

chmod 0755 /usr/local/bin/run-cloudopstracker-web

cat >/etc/systemd/system/cloudopstracker-api.service <<'EOF'
[Unit]
Description=CloudOpsTracker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudops
WorkingDirectory=/opt/cloudopstracker/api
ExecStart=/usr/local/bin/run-cloudopstracker-api
Restart=always
RestartSec=5
StandardOutput=append:/var/log/cloudopstracker/api.log
StandardError=append:/var/log/cloudopstracker/api.log

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/cloudopstracker-web.service <<'EOF'
[Unit]
Description=CloudOpsTracker Web
After=network-online.target cloudopstracker-api.service
Wants=network-online.target

[Service]
Type=simple
User=cloudops
WorkingDirectory=/opt/cloudopstracker/web
ExecStart=/usr/local/bin/run-cloudopstracker-web
Restart=always
RestartSec=5
StandardOutput=append:/var/log/cloudopstracker/web.log
StandardError=append:/var/log/cloudopstracker/web.log

[Install]
WantedBy=multi-user.target
EOF

rm -f /etc/nginx/conf.d/default.conf

cat >/etc/nginx/conf.d/cloudopstracker.conf <<'EOF'
server {
    listen 80 default_server;
    server_name _;

    add_header X-CloudOps-Instance $hostname always;

    location = /healthz {
        proxy_pass http://127.0.0.1:5000/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
EOF

%{ if application_log_group != "" ~}
cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path":"/var/log/cloudopstracker/api.log","log_group_name":"${application_log_group}","log_stream_name":"{instance_id}/api"},
          {"file_path":"/var/log/cloudopstracker/web.log","log_group_name":"${application_log_group}","log_stream_name":"{instance_id}/web"},
          {"file_path":"/var/log/cloudopstracker-bootstrap.log","log_group_name":"${application_log_group}","log_stream_name":"{instance_id}/bootstrap"}
        ]
      }
    }
  }
}
EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s
systemctl enable amazon-cloudwatch-agent
%{ endif ~}

# Bound local disk use when centralized collection is disabled or unavailable.
cat >/etc/logrotate.d/cloudopstracker <<'EOF'
/var/log/cloudopstracker/*.log {
    daily
    rotate 7
    size 10M
    missingok
    notifempty
    copytruncate
    compress
}
EOF

systemctl daemon-reload
systemctl enable cloudopstracker-api
systemctl enable cloudopstracker-web
systemctl enable nginx

runuser -u cloudops -- /usr/local/bin/run-cloudopstracker-api --migrate-only

systemctl restart cloudopstracker-api
systemctl restart cloudopstracker-web
systemctl restart nginx

# Bounded polling of actual health, never a fixed readiness sleep.
curl --fail --silent --retry 30 --retry-all-errors --retry-delay 2 --max-time 10 \
  http://127.0.0.1:5001/health/ready >/dev/null
curl --fail --silent --retry 30 --retry-all-errors --retry-delay 2 --max-time 10 \
  http://127.0.0.1/health/ready >/dev/null
touch /opt/cloudopstracker/bootstrap-ready
echo "CloudOpsTracker bootstrap finished."
